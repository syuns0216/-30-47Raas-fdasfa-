{
  "description": "ALB、EC2、RDSで構成される3層アーキテクチャ",
  "resources": [
    {
      "type": "VPC",
      "name": "main-vpc",
      "cidr": "10.0.0.0/16"
    },
    {
      "type": "Subnet",
      "name": "public-subnet-1a",
      "cidr": "10.0.1.0/24",
      "az": "ap-northeast-1a"
    },
    {
      "type": "Subnet",
      "name": "public-subnet-1c",
      "cidr": "10.0.2.0/24",
      "az": "ap-northeast-1c"
    },
    {
      "type": "Subnet",
      "name": "private-subnet-1a",
      "cidr": "10.0.11.0/24",
      "az": "ap-northeast-1a"
    },
    {
      "type": "Subnet",
      "name": "private-subnet-1c",
      "cidr": "10.0.12.0/24",
      "az": "ap-northeast-1c"
    },
    {
      "type": "ALB",
      "name": "web-alb",
      "subnets": ["public-subnet-1a", "public-subnet-1c"]
    },
    {
      "type": "EC2",
      "name": "app-server",
      "instance_type": "t3.micro",
      "subnet": "public-subnet-1a"
    },
    {
      "type": "RDS",
      "name": "app-database",
      "engine": "mysql",
      "instance_class": "db.t3.micro",
      "subnets": ["private-subnet-1a", "private-subnet-1c"]
    }
  ]
}